GOOGLE_API_KEY=cole_sua_api_key_aqui
GOOGLE_CSE_ID=518c6c914a2b74eb9

# Configuração do Ollama (memória e contexto)
# num_ctx: janela de contexto total (prompt + resposta).
#   12288 → padrão recomendado para 7B+ (RAM: ~10–14 GB)
#   8192  → se tiver pouca RAM com o 7B
#   4096  → para o 3B com pouca RAM
OLLAMA_NUM_CTX=12288
# num_predict: máximo de tokens gerados. -1 = sem limite (recomendado).
# Se a resposta ficar muito lenta, use 1500 ou 2000.
OLLAMA_NUM_PREDICT=-1
# Modelo padrão leve para abrir rápido. Troque manualmente nas configurações se quiser 7B/14B.
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_KEEP_ALIVE=5m

# Performance do chat
# FAST_PATH: cumprimentos e perguntas simples; STANDARD_PATH: memória/RAG normal; DEEP_PATH: auditorias longas.
AETHER_FAST_MODEL=qwen2.5-coder:3b
AETHER_USE_FAST_MODEL=0
AETHER_FAST_HISTORY=4
AETHER_STANDARD_HISTORY=8
AETHER_DEEP_HISTORY=12
AETHER_FAST_NUM_CTX=2048
AETHER_STANDARD_NUM_CTX=4096
AETHER_DEEP_NUM_CTX=8192
AETHER_FAST_NUM_PREDICT=120
AETHER_STANDARD_NUM_PREDICT=420
AETHER_DEEP_NUM_PREDICT=1100
AETHER_PERF_LOG=0

# Voz local/offline
# O frontend usa a voz do navegador por padrão. Se quiser TTS local pelo backend,
# instale o Piper nativo no Mac e, se necessário, informe o caminho aqui.
# Exemplo: AETHER_PIPER_BIN=/Users/vitor/.local/bin/piper
AETHER_PIPER_BIN=

# Acesso remoto/mobile
# Mesma Wi-Fi: use start_mobile_backend.sh + npm run dev:mobile.
# Wi-Fi diferente: recomendado usar Tailscale. Se usar Cloudflare Tunnel/ngrok,
# coloque aqui as URLs publicas geradas.
NEXUS_REMOTE_MODE=false
NEXUS_PORT=5050
NEXUS_FRONTEND_PORT=5174
NEXUS_AUTH_TOKEN=
NEXUS_PUBLIC_URL=
NEXUS_PUBLIC_FRONTEND_URL=
