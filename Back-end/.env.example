GOOGLE_API_KEY=cole_sua_api_key_aqui
GOOGLE_CSE_ID=518c6c914a2b74eb9

# Supabase sync local-first
SUPABASE_SYNC_ENABLED=0
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=cole_sua_anon_key_aqui
# Opcional para uso pessoal local. Não distribua app com service_role embutida.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SYNC_TABLE=nexus_sync_records

# Configuração do Ollama (memória e contexto)
# num_ctx: janela de contexto total (prompt + resposta).
#   12288 → padrão recomendado para 7B+ (RAM: ~10–14 GB)
#   8192  → se tiver pouca RAM com o 7B
#   4096  → para o 3B com pouca RAM
OLLAMA_NUM_CTX=12288
# num_predict: máximo de tokens gerados. -1 = sem limite (recomendado).
# Se a resposta ficar muito lenta, use 1500 ou 2000.
OLLAMA_NUM_PREDICT=-1
# Modelo padrão (ex: qwen2.5-coder:3b, qwen2.5:7b, llama3:8b, mistral)
OLLAMA_MODEL=qwen2.5-coder:7b
