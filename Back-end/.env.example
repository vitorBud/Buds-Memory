# O Google Custom Search é opcional. Não coloque credenciais reais no Git.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Configuração do Ollama (memória e contexto)
# num_ctx: janela de contexto total (prompt + resposta).
#   12288 → exemplo para 7B+ em máquina com RAM suficiente
#   8192  → se tiver pouca RAM com o 7B
#   4096  → para o 3B com pouca RAM
# O runtime usa 8192 quando esta variável não é definida.
OLLAMA_NUM_CTX=12288
# num_predict: máximo de tokens gerados. -1 = sem limite (recomendado).
# Se a resposta ficar muito lenta, use 1500 ou 2000.
OLLAMA_NUM_PREDICT=-1
# Modelo padrão leve para abrir rápido. Troque manualmente nas configurações se quiser 7B/14B.
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_KEEP_ALIVE=5m

# Performance do chat
# FAST_PATH: cumprimentos e perguntas simples; STANDARD_PATH: memória/RAG normal; DEEP_PATH: auditorias longas.
BUDS_FAST_MODEL=qwen2.5-coder:3b
BUDS_USE_FAST_MODEL=0
BUDS_FAST_HISTORY=4
BUDS_STANDARD_HISTORY=8
BUDS_DEEP_HISTORY=12
BUDS_FAST_NUM_CTX=2048
BUDS_STANDARD_NUM_CTX=4096
BUDS_DEEP_NUM_CTX=8192
BUDS_FAST_NUM_PREDICT=120
BUDS_STANDARD_NUM_PREDICT=420
BUDS_DEEP_NUM_PREDICT=1100
BUDS_PERF_LOG=0

# Voz desktop local/offline. O iPhone usa Kokoro nativo e não lê esta variável.
# O frontend desktop usa a voz do sistema por padrão. Para TTS pelo backend,
# instale Piper e informe o caminho quando a descoberta automática não bastar.
# Exemplo macOS: BUDS_PIPER_BIN=/Users/seu-usuario/.local/bin/piper
BUDS_PIPER_BIN=

# Acesso web remoto (não é necessário para o app nativo do iPhone).
# Mesma Wi-Fi: use start_mobile_backend.sh + npm run dev em terminais separados.
# Wi-Fi diferente: recomendado usar Tailscale. Se usar Cloudflare Tunnel/ngrok,
# coloque aqui as URLs públicas geradas.
NEXUS_REMOTE_MODE=false
NEXUS_PORT=5050
NEXUS_FRONTEND_PORT=5174
NEXUS_AUTH_TOKEN=
NEXUS_PUBLIC_URL=
NEXUS_PUBLIC_FRONTEND_URL=
NEXUS_SESSION_TTL_HOURS=24
